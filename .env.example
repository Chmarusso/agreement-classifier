APP_ENV=development
DATABASE_URL=postgres://audit:audit@localhost:5544/audit
TEST_DATABASE_URL=postgres://audit:audit@localhost:5544/postgres
AUTH_SECRET=change-me-in-production
# Always-valid OTP code. Refused when APP_ENV=production.
DEV_OTP_CODE=000000
# Registered as admin on API start when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
API_PORT=3000
STORAGE_DIR=./data/uploads
# Audit model. openrouter (cheap placeholder, default when OPENROUTER_API_KEY is set),
# claude-cli (host `claude` login), claude-bridge (worker in Docker), or stub (no calls).
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# off (default, faster and cheaper), low, or provider-default for models without reasoning control
OPENROUTER_REASONING=off
# OPENROUTER_API_KEY=sk-or-...   (read from your shell if not set here)
CLAUDE_MODEL=opus
LLM_TIMEOUT_MS=180000
WORKER_CONCURRENCY=3
AUDIT_VOTING=uncertain
AUDIT_VOTE_SAMPLES=2
AUDIT_VOTE_TEMPERATURE=0.3
# Local anonymizer (apps/anonymizer, started by `bun run dev`). Personal data is replaced with
# placeholders such as <PERSON_1> before agreement text reaches any model. Leave empty to turn it off.
ANONYMIZER_URL=http://localhost:8090
# Terms that stay readable, separated by ";": usually the company's own name.
ANONYMIZER_KEEP=Northwind Analytics
